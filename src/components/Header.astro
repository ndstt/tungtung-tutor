---
import { CONTACTS, NAV, SITE } from '../data/tutor';
import logo from '../assets/tungtung-tutor-logo.svg';
---

<header class="sticky top-0 z-50 border-b-4 border-ink bg-cream">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
    <a href="#" class="flex items-center gap-2.5 font-display text-lg font-black tracking-tight sm:text-xl group">
      <img
        src={logo.src}
        alt="Tungtung Tutor Logo"
        width="40"
        height="40"
        class="h-9 w-9 rounded-md border-2 border-ink bg-cream shadow-[2px_2px_0px_0px_#111827] transition-transform group-hover:-translate-x-0.5 group-hover:-translate-y-0.5"
      />
      <span>{SITE.name.toUpperCase()}</span>
    </a>
    <nav aria-label="เมนูหลัก" class="hidden gap-5 font-bold md:flex">
      {NAV.map((n) => <a href={n.href} class="hover:underline hover:decoration-4 hover:underline-offset-4">{n.label}</a>)}
    </nav>
    <a
      href={CONTACTS.line}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-md border-2 border-ink bg-hot px-3 py-1.5 text-sm font-bold text-white shadow-[3px_3px_0px_0px_#111827] transition-transform hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[5px_5px_0px_0px_#111827]"
    >
      ทักไลน์
    </a>
  </div>
</header>
