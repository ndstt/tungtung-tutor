---
import { PRICING } from '../data/tutor';
import SectionHeading from './SectionHeading.astro';
---

<section id="pricing" aria-labelledby="pricing-title" class="border-b-4 border-ink">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
    <SectionHeading id="pricing-title" eyebrow="PRICING">{PRICING.heading}</SectionHeading>
    <p class="mb-6 inline-block -rotate-1 rounded-md border-4 border-ink bg-lime px-3 py-1 font-extrabold shadow-[4px_4px_0px_0px_#111827]">
      {PRICING.pill}
    </p>

    <div class="overflow-x-auto rounded-md border-4 border-ink bg-white shadow-[6px_6px_0px_0px_#111827]">
      <table class="w-full min-w-[520px] border-collapse text-left">
        <thead class="bg-ink text-white">
          <tr>
            {PRICING.columns.map((c, i) => <th scope="col" class:list={['p-3 font-bold sm:p-4', i === 1 && 'text-lime', i === 2 && 'text-hot']}>{c}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            PRICING.rows.map((r) => (
              <tr class:list={['border-t-4 border-ink', 'highlight' in r && r.highlight && 'bg-lime']}>
                <th scope="row" class="p-3 font-extrabold sm:p-4">
                  {r.label}
                  {'badge' in r && r.badge && (
                    <span class="ml-2 inline-block border-2 border-ink bg-hot px-2 py-0.5 text-xs font-bold text-white">{r.badge}</span>
                  )}
                </th>
                <td class="p-3 text-xl font-black sm:p-4">{r.math} <span class="text-sm font-semibold">บ./ชม.</span></td>
                <td class="p-3 text-xl font-black text-hot sm:p-4">{r.prog} <span class="text-sm font-semibold text-ink">บ./ชม.</span></td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-8 flex flex-wrap items-center gap-3 rounded-md border-4 border-ink bg-ink p-4 font-semibold text-white shadow-[6px_6px_0px_0px_#FF5722]">
      <span class="border-2 border-ink bg-lime px-2 font-display font-bold text-ink">{PRICING.noteTag}</span>
      <span class="min-w-0 flex-1">{PRICING.note}</span>
    </p>
  </div>
</section>
