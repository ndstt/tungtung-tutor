---
import { REVIEWS } from '../data/tutor';
import SectionHeading from './SectionHeading.astro';
---

<section id="reviews" aria-labelledby="reviews-title" class="border-b-4 border-ink">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
    <SectionHeading id="reviews-title" eyebrow="REVIEWS">{REVIEWS.heading}</SectionHeading>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        REVIEWS.items.map((r) => (
          <article
            class:list={['rounded-md border-4 border-ink p-4 shadow-[6px_6px_0px_0px_#111827] transition-transform hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[8px_8px_0px_0px_#111827]', r.rotate]}
            style={`background-color:${r.bg}`}
          >
            {r.image ? (
              <img src={r.image} alt={r.alt ?? 'รีวิวจากนักเรียน'} loading="lazy" decoding="async" class="w-full border-2 border-ink" />
            ) : (
              <div class="flex aspect-[4/3] items-center justify-center border-2 border-dashed border-ink text-center font-bold">
                {REVIEWS.sub}
              </div>
            )}
          </article>
        ))
      }
    </div>

    <aside class="mt-12 rounded-md border-4 border-ink bg-white p-5 shadow-[6px_6px_0px_0px_#111827]" aria-label={REVIEWS.availability.title}>
      <h3 class="text-xl font-black">{REVIEWS.availability.title}</h3>
      <p class="font-semibold">{REVIEWS.availability.text}</p>
    </aside>
  </div>
</section>
